upstream school_guard_app {
    server 127.0.0.1:8001;
    keepalive 16;
}

server {
    listen 80;
    server_name salidas.example.edu.co;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name salidas.example.edu.co;

    ssl_certificate /etc/letsencrypt/live/salidas.example.edu.co/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/salidas.example.edu.co/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    server_tokens off;
    client_max_body_size 210m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;

    # Salud: permitir solo monitoreo interno.
    location = /healthz {
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        proxy_pass http://school_guard_app;
    }

    # Service worker con scope raíz y sin caché.
    location = /sw.js {
        proxy_pass http://school_guard_app;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-cache" always;
    }

    # Nunca servir fotos desde el árbol estático.
    location /static/photos {
        return 404;
    }

    location /static/ {
        alias /opt/school-guard/app/static/;
        expires 30d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # Fotos privadas: siempre pasan por la aplicación (sesión + permisos).
    location /media/ {
        proxy_pass http://school_guard_app;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    location / {
        proxy_pass http://school_guard_app;
    }
}
