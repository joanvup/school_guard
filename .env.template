# --- Aplicación ---
APP_ENV=production

# --- Base de datos ---
DATABASE_URL=mysql+pymysql://school_guard_db_user:CAMBIAR_CONTRASENA@localhost/school_guard_db

# --- Sesiones (JWT) ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
# true cuando la app se sirve por HTTPS
COOKIE_SECURE=true

# --- Carnets QR ---
# Clave actual y, durante la rotación, la clave anterior de los carnets ya impresos.
QR_SECRET_KEY_CURRENT=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
QR_SECRET_KEY_PREVIOUS=
# Compatibilidad con instalaciones antiguas: si solo existe QR_SECRET_KEY, se usa como actual.
# QR_SECRET_KEY=

# --- Operación ---
TIMEZONE=America/Bogota
COOLDOWN_MINUTES=15
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5

# --- Ventana de almuerzo ---
LUNCH_WINDOW_START=11:00
LUNCH_WINDOW_END=14:00
# off: solo registra; warn: registra y avisa; deny: rechaza fuera de la ventana
LUNCH_WINDOW_ENFORCEMENT=off

# --- Seguridad web ---
# enforce aplica la CSP; report-only solo reporta; off desactiva la CSP.
# Para el primer despliegue se recomienda report-only y luego enforce.
CSP_MODE=enforce
# HSTS solo se envía cuando la petición llega por HTTPS.
HSTS_MAX_AGE=31536000

# --- Medios privados ---
# Las fotos se sirven autenticadas desde /media/photos; nunca desde /static.
MEDIA_PHOTOS_DIR=app/data/photos
# Límite por archivo (fotos e importaciones Excel).
MAX_UPLOAD_MB=5
# Límites para la importación masiva de fotos en ZIP.
MAX_ZIP_ENTRIES=1000
MAX_ZIP_TOTAL_MB=200

# --- Política de contraseñas ---
PASSWORD_MIN_LENGTH=12

# --- Bootstrap ---
# Obligatoria solo para crear el administrador inicial (mínimo 12 caracteres).
BOOTSTRAP_ADMIN_PASSWORD=
